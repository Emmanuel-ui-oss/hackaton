FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends gcc pkg-config && rm -rf /var/lib/apt/lists/*

COPY core/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY core/ /app/core/
COPY backend/apps/ /app/backend/apps/
COPY backend/config/ /app/backend/config/
COPY backend/manage.py /app/backend/manage.py

EXPOSE 9100

CMD ["python", "core/server.py", "--host", "0.0.0.0", "--port", "9100"]
