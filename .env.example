# ── Django ──
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=False
ALLOWED_HOSTS=*

# ── Dominio (CORS + ALLOWED_HOSTS) ──
# Separar múltiples dominios con coma: midominio.com,api.midominio.com
DOMAIN=

# ── Base de datos ──
DB_ENGINE=django.db.backends.mysql
DB_NAME=visionvial_prod
DB_USER=root
DB_PASSWORD=root
DB_HOST=db
DB_PORT=3306

# ── Servidor ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── Superusuario inicial (entrypoint.sh) ──
DJANGO_SUPERUSER_PASSWORD=change-me

# ── Core ML ──
CORE_HOST=core
CORE_PORT=9100
CORE_TIMEOUT=5

# ── Passwords de seed ──
ADMIN_PASSWORD=change-me
DEMO_PASSWORD=change-me
MARIA_PASSWORD=change-me
INGESTOR_PASSWORD=change-me

# ── Email (SOS) ──
# Por defecto usa console.EmailBackend (solo imprime en consola).
# Para enviar correos reales, configura un SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=tu-contraseña-de-app
# DEFAULT_FROM_EMAIL=tu-correo@gmail.com