# ── Django ──
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=False
ALLOWED_HOSTS=*

# ── Dominio (CORS + ALLOWED_HOSTS) ──
# Separar múltiples dominios con coma: midominio.com,api.midominio.com
DOMAIN=

# ── Base de datos ──
DB_ENGINE=django.db.backends.mysql
DB_NAME=visionvial_prod
DB_USER=root
DB_PASSWORD=root
DB_HOST=db
DB_PORT=3306

# ── Servidor ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── Superusuario inicial (entrypoint.sh) ──
DJANGO_SUPERUSER_PASSWORD=change-me

# ── Core ML ──
CORE_HOST=core
CORE_PORT=9100
CORE_TIMEOUT=5

# ── Passwords de seed ──
ADMIN_PASSWORD=change-me
DEMO_PASSWORD=change-me
MARIA_PASSWORD=change-me
INGESTOR_PASSWORD=change-me

# Tokens
VITE_MAPTILER_KEY=
GEMINI_API_KEY=
VITE_TOMTOM_KEY=